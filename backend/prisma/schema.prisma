datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Job {
  id        Int       @id @default(autoincrement())
  title     String
  type      String
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}
